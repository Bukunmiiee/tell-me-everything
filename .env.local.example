# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored by Next.js by default — never commit it.

# Safe to expose to the browser (Supabase's public anon key is designed for this,
# and RLS with zero public policies means it can't read/write anything anyway).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET — server-side only. Never prefix this with NEXT_PUBLIC_.
# Used only inside server routes / server components to talk to the database.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECRET — used only in server code to send emails via Resend.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Tell Me Everything <you@yourdomain.com>"

# Base URL of your deployed app, used to build status links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
